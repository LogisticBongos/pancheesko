DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-client-id
GUILD_ID=optional-test-guild-id-for-fast-command-registration

# Server name / short description
COMMUNITY_NAME=Pancheesko
COMMUNITY_TAGLINE=

# Main category from your server screenshot
RULES_CHANNEL_ID=
MAIL_CHANNEL_ID=
ROLES_CHANNEL_ID=
VERIFY_CHANNEL_ID=
INTRO_CHANNEL_ID=
LOG_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# 001 category
GENERAL_CHANNEL_ID=
MEDIA_CHANNEL_ID=
GAMING_CHANNEL_ID=
ART_CHANNEL_ID=
CLIPS_CHANNEL_ID=
VENT_CHANNEL_ID=

# 002 category
BOTS_CHANNEL_ID=
MUSIC_CHANNEL_ID=
BIRTHDAY_CHANNEL_ID=

# 003 category
OVERWATCH_CHANNEL_ID=
DEADLOCK_CHANNEL_ID=
DBD_CHANNEL_ID=
ROBLOX_USER_CHANNEL_ID=

# Bot-led onboarding roles
# MEMBER_ROLE_ID is given after someone completes the bot intro form.
# UNVERIFIED_ROLE_ID is optional. If set, it is added on join and removed after verification.
MEMBER_ROLE_ID=
UNVERIFIED_ROLE_ID=

# Selectable roles shown in #roles. Leave blank to hide an option.
GAMER_ROLE_ID=
MUSIC_ROLE_ID=
ART_ROLE_ID=
MEDIA_ROLE_ID=
OVERWATCH_ROLE_ID=
DEADLOCK_ROLE_ID=
DBD_ROLE_ID=
BIRTHDAY_ROLE_ID=

# Community links used by /links
WEBSITE_URL=
TWITCH_URL=
YOUTUBE_URL=
SPOTIFY_URL=
SOUNDCLOUD_URL=
STEAM_GROUP_URL=

# Moderation safeguards
AUTO_BAN_MINUS15_ROLE_ID=
AUTO_BAN_MINUS15_ROLE_NAME=-15
AUTO_BAN_REASON=Automatic ban: member has the configured -15 role.
AUTO_BAN_SCAN_ON_READY=false
AUTO_BAN_DRY_RUN=false
