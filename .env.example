# Optional role panels. Use JSON arrays.
# Button role example:
# BUTTON_ROLE_SETS=[{"message":"Pick your pings.","roles":[{"label":"Events","roleId":"123","emoji":"🎮"},{"label":"Music","roleId":"456","emoji":"🎵"}]}]
